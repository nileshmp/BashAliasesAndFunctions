function show.fmt.files()
{
    find . -name '*.go' -not -path './vendor/*' | xargs gofmt -l
}

function fmt.files()
{
    find . -name '*.go' -not -path './vendor/*' | xargs gofmt -l | xargs gofmt -w
}


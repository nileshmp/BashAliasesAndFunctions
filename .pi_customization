# --- Pi Customization Helper Functions ---

echo "Loading Pi customization functions..."

_PI_WRAPPER_DIR="$HOME/.pi/wrapper"                          # per-project files live under projects/
_PI_MODELS_CONF="${${(%):-%x}:a:h}/.pi_models.conf"          # shared: next to this script
_PI_MAX_RETRIES=${PI_MAX_RETRIES:-3}                         # attempts for re-asked prompts

# --- Section 0: Project Files ---

_pi_project_key() {
    # Prints the folder name pi uses for the current directory's sessions
    # (~/.pi/agent/sessions/--Users-me-proj--). The wrapper uses the same name
    # for its own per-project folder, so the two line up.
    local cwd=${PWD:A}  # symlinks resolved, like pi's process.cwd()
    print -r -- "--${${cwd#/}//[\/\\:]/-}--"
}

_pi_project_files() {
    # Sets `provider_file` and `sessions_dir` in the caller's scope for the
    # current directory, under ~/.pi/wrapper/projects/<project key>.
    local dir="$_PI_WRAPPER_DIR/projects/$(_pi_project_key)"
    provider_file="$dir/providers.enc"
    sessions_dir="$dir/sessions"

    # Move in files that older versions of this wrapper kept in the project folder.
    local old_file=".pi_providers.enc" old_sessions=".pi_sessions" f
    [[ -f "$old_file" || -d "$old_sessions" ]] || return 0
    ( umask 077; mkdir -p "$sessions_dir" ) || return 1
    if [[ -f "$old_file" ]]; then
        if [[ -e "$provider_file" ]]; then
            echo "Warning: $provider_file already exists; leaving $PWD/$old_file in place."
        else
            mv "$old_file" "$provider_file" && echo "Moved $PWD/$old_file -> $provider_file"
        fi
    fi
    if [[ -d "$old_sessions" ]]; then
        for f in "$old_sessions"/*(DN); do
            mv -n "$f" "$sessions_dir/"
        done
        if rmdir "$old_sessions" 2>/dev/null; then
            echo "Moved $PWD/$old_sessions/ -> $sessions_dir/"
        else
            echo "Warning: some logs in $PWD/$old_sessions/ share a name with existing ones and were left in place."
        fi
    fi
}

# --- Section 1: Provider & Encryption Management ---

_pi_get_password() {
    # Prompts (hidden) for a password twice and returns it in REPLY once both
    # entries match - since the typing can't be seen, the second entry is the
    # only guard against a typo. Gives up after $_PI_MAX_RETRIES mismatches.
    local pw confirm attempt
    for (( attempt = 1; attempt <= _PI_MAX_RETRIES; attempt++ )); do
        read -s "pw?$1"; echo
        read -s "confirm?Confirm password: "; echo
        if [[ "$pw" == "$confirm" ]]; then
            REPLY=$pw
            return 0
        fi
        echo -n "Passwords do not match."
        (( attempt < _PI_MAX_RETRIES )) && echo " Please try again ($attempt/$_PI_MAX_RETRIES)."
    done
    echo " Too many failed attempts. Aborting."
    return 1
}

_pi_valid_entry() {
    # True if $1 is a well-formed `provider=key` line. Used both when adding a
    # provider and when checking a decryption, so anything saved can be read back.
    local LC_ALL=C  # byte-wise matching, so garbage bytes don't raise regex errors
    [[ "$1" =~ ^[A-Za-z0-9_-]+=[[:print:]]+$ ]]
}

_pi_encrypt_providers() {
    # $1: plaintext provider data, $2: password. umask keeps the file private from the start.
    ( umask 077
      print -r -- "$1" | openssl enc -aes-256-cbc -pass pass:"$2" -pbkdf2 -out "$provider_file" )
}

_pi_decrypt_providers() {
    # $1: password. Prints the plaintext; returns 1 on failure.
    # openssl usually fails on a bad password, but roughly 1 in 256 wrong
    # passwords still pass the padding check and yield garbage. Only accept
    # output where every non-empty line looks like `provider=key`.
    local plaintext line
    plaintext=$(openssl enc -d -aes-256-cbc -pass pass:"$1" -pbkdf2 -in "$provider_file" 2>/dev/null) || return 1
    [[ -n "$plaintext" ]] || return 1
    while IFS= read -r line; do
        [[ -z "$line" ]] || _pi_valid_entry "$line" || return 1
    done <<< "$plaintext"
    print -r -- "$plaintext"
}

_pi_unlock() {
    # Asks for the project password and decrypts the provider file.
    # Sets `password` and `plaintext` in the caller's scope.
    _pi_get_password "Enter provider password for this project: " || return 1
    password=$REPLY
    plaintext=$(_pi_decrypt_providers "$password") && return 0
    echo "Decryption failed. Invalid password."
    return 1
}

pi_show_providers() {
    # Prints this project's providers. Keys are masked unless --reveal is given.
    local password plaintext line key provider_file sessions_dir
    _pi_project_files || return 1
    if [[ ! -f "$provider_file" ]]; then
        echo "No provider file found in $PWD."
        return 1
    fi
    _pi_unlock || return 1
    if [[ "$1" == "--reveal" ]]; then
        print -r -- "$plaintext"
        return 0
    fi
    for line in ${(f)plaintext}; do
        key=${line#*=}
        if (( ${#key} > 8 )); then key="${key[1,4]}...${key[-4,-1]}"; else key="****"; fi
        print -r -- "${line%%=*}=$key"
    done
}

_pi_add_new_provider() {
    # $1: existing provider plaintext (may be empty). Returns the updated plaintext
    # in REPLY and sets `new_provider` in the caller's scope. Adding a provider
    # that already exists replaces its key in place.
    local name key i
    local -a lines=(${(f)1})
    read -r "name?Enter provider name (e.g., openai, google): "
    read -r "key?Enter API key for '$name': "  # -r: keep backslashes in the key
    echo
    if ! _pi_valid_entry "$name=$key"; then
        echo "Provider name must be letters, digits, '-' or '_', and the key cannot be empty."
        return 1
    fi
    i=${lines[(i)${(b)name}=*]}  # index of the existing entry, or one past the end
    (( i <= ${#lines} )) && echo "Replacing the existing key for '$name'."
    lines[i]="$name=$key"
    REPLY=${(F)lines}
    new_provider=$name
}

_pi_menu() {
    # $1: title, remaining args: items. Sets REPLY to the chosen 1-based index, or 0 if invalid.
    print -r -- "$1"; shift
    local i choice
    for (( i = 1; i <= $#; i++ )); do print -r -- "$i) ${@[i]}"; done
    read "choice?Enter your choice: "
    if [[ "$choice" == <1-> ]] && (( choice <= $# )); then REPLY=$choice; else REPLY=0; fi
}

_pi_model_menu() {
    # $1: provider name. Returns the chosen model id in REPLY.
    if [[ ! -f "$_PI_MODELS_CONF" ]]; then
        echo "Model configuration file not found. Creating a default '$_PI_MODELS_CONF'."
        cat > "$_PI_MODELS_CONF" <<'EOF'
# This file configures the models available for each provider in the pi wrapper script.
# Format: model_id="Friendly Display Name"

[google]
gemini-flash-latest="Gemini Flash (Latest)"
gemini-3.1-pro-preview="Gemini 3.1 Pro (Preview)"
gemini-2.5-flash="Gemini 2.5 Flash"

[openai]
gpt-5.5="GPT-5.5"
gpt-5.4-mini="GPT-5.4 Mini"
gpt-5.3-codex="GPT-5.3 Codex"

[anthropic]
claude-opus-5="Claude Opus 5"
claude-sonnet-5="Claude Sonnet 5"
claude-haiku-4-5="Claude Haiku 4.5"
EOF
    fi

    # Collect `id="Name"` lines from the INI-style [provider] section.
    local line section
    local -a ids names
    for line in "${(@f)$(<"$_PI_MODELS_CONF")}"; do
        if [[ "$line" == \[*\] ]]; then
            section=${line[2,-2]}
        elif [[ "$section" == "$1" && "$line" == [^#]*=* ]]; then
            ids+=("${line%%=*}")
            names+=("${${line#*=}//\"/}")
        fi
    done

    if (( ! ${#ids} )); then
        echo "Warning: No models found for provider '$1' in $_PI_MODELS_CONF."
        return 1
    fi

    _pi_menu "Select a model for '$1':" "${names[@]}"
    if (( ! REPLY )); then
        echo "Invalid choice. Aborting."
        return 1
    fi
    REPLY=${ids[REPLY]}
}

_pi_provider_env_var() {
    # Prints the environment variable pi reads the API key from for provider $1.
    # Most follow PROVIDER_API_KEY (hyphens -> underscores); the exceptions
    # below are taken from pi-coding-agent 0.85.1's provider table.
    case "$1" in
        google)                     echo "GEMINI_API_KEY" ;;
        google-vertex)              echo "GOOGLE_CLOUD_API_KEY" ;;
        azure-openai-responses)     echo "AZURE_OPENAI_API_KEY" ;;
        vercel-ai-gateway)          echo "AI_GATEWAY_API_KEY" ;;
        moonshotai|moonshotai-cn)   echo "MOONSHOT_API_KEY" ;;
        huggingface)                echo "HF_TOKEN" ;;
        opencode-go)                echo "OPENCODE_API_KEY" ;;
        kimi-coding)                echo "KIMI_API_KEY" ;;
        cloudflare-workers-ai|cloudflare-ai-gateway) echo "CLOUDFLARE_API_KEY" ;;
        qwen-token-plan-individual) echo "QWEN_TOKEN_PLAN_API_KEY" ;;
        *) echo "${${1:u}//-/_}_API_KEY" ;;
    esac
}

_pi_handle_providers() {
    # Unlocks (or creates) the project's provider file and lets the user pick a
    # provider and model. Sets `provider_args` in the caller's scope.
    local password plaintext choice reply new_provider attempt
    local -a lines

    if [[ ! -f "$provider_file" ]]; then
        # First-time initialization: re-ask for the provider on bad input.
        read "reply?No provider file found. Create one? [Y/n] "
        [[ "$reply" == [nN] ]] && return 0
        _pi_get_password "Enter new password for this project: " || return 1
        password=$REPLY
        for (( attempt = 1; attempt <= _PI_MAX_RETRIES; attempt++ )); do
            _pi_add_new_provider "" && break
        done
        if [[ -z "$new_provider" ]]; then
            # Don't write an empty file - it would decrypt to nothing and
            # be reported as a bad password on every later run.
            echo "No provider file created."
            return 1
        fi
    else
        # Show the menu again when adding a provider fails (blank/invalid input).
        _pi_unlock || return 1
        lines=(${(f)plaintext})
        for (( attempt = 1; ; attempt++ )); do
            _pi_menu "Select a provider for this session:" "${lines[@]%%=*}" \
                "[Add a new provider]" "[Continue without a provider]"
            choice=$REPLY
            if (( choice >= 1 && choice <= ${#lines} )); then
                break  # an existing provider: nothing to save
            elif (( choice != ${#lines} + 1 )); then
                return 0  # "Continue without a provider", or an invalid choice.
            fi
            _pi_add_new_provider "$plaintext" && break
            if (( attempt >= _PI_MAX_RETRIES )); then
                echo "Too many failed attempts. Aborting."
                return 1
            fi
            echo
        done
    fi

    # A provider was just added or updated: save it and use it for this session.
    if [[ -n "$new_provider" ]]; then
        plaintext=$REPLY
        _pi_encrypt_providers "$plaintext" "$password"
        echo "Provider saved successfully."
        lines=(${(f)plaintext})
        choice=${lines[(i)${(b)new_provider}=*]}
    fi

    local provider=${lines[choice]%%=*} key=${lines[choice]#*=}
    if ! _pi_model_menu "$provider"; then
        echo "Aborting due to model selection issue."
        return 1
    fi
    provider_args=("--provider" "$provider" "--model" "$REPLY")
    # pi takes the API key from an environment variable (e.g. OPENAI_API_KEY), not a flag.
    export "$(_pi_provider_env_var "$provider")=$key"
    echo "Using provider: $provider, Model: $REPLY"
}

# --- Section 2: Session Recording & Management ---
#
# Session resumption is delegated to pi itself (--resume/-r, --continue/-c,
# --session, --fork); pi owns the real conversation state. The logs written to
# $sessions_dir are script(1) terminal recordings, for human reading only.

_pi_sanitize_filename() {
    setopt localoptions extendedglob
    local name=${1//[^a-zA-Z0-9._]/-}
    name=${name//-##/-}
    name=${name#-}
    print -r -- "${name%-}"
}

_pi_parse_args() {
    # Picks up `--name|-n <value>` into `custom_session_name` for the log file
    # name. The flag stays in `pi_args`, since pi uses it too: as the session's
    # display name in `pi -r` / `/resume`. A flag with no value is dropped.
    local -a rest
    local i
    for (( i = 1; i <= ${#pi_args}; i++ )); do
        if [[ "${pi_args[i]}" != (--name|-n) ]]; then
            rest+=("${pi_args[i]}")
        elif [[ -n "${pi_args[i+1]}" ]]; then
            custom_session_name=${pi_args[i+1]}
            rest+=("${pi_args[i]}" "${pi_args[++i]}")
        else
            echo "Warning: ${pi_args[i]} flag provided without a value. Ignoring."
        fi
    done
    pi_args=("${rest[@]}")
}

_pi_session_label() {
    # Prints a one-line description of pi session file $1, like pi's own picker:
    # its name if it has one (else its first message), and how long ago it was used.
    zmodload -F zsh/stat b:zstat
    zmodload zsh/datetime
    local label mtime age
    if (( $+commands[jq] )); then
        label=$(jq -rs '
            ([.[] | select(.type == "session_info") | .name] | last) //
            ([.[] | select(.type == "message" and .message.role == "user") | .message.content
              | if type == "string" then . else map(select(.type == "text").text) | join(" ") end][0]) //
            ""' "$1" 2>/dev/null)
        label=${${(j: :)${=label}}[1,50]}  # collapse whitespace/newlines, cap the length
    fi
    zstat -A mtime +mtime "$1"
    age=$(( EPOCHSECONDS - mtime ))
    if   (( age < 60 ));    then age="just now"
    elif (( age < 3600 ));  then age="$(( age / 60 )) min ago"
    elif (( age < 7200 ));  then age="1 hour ago"
    elif (( age < 86400 )); then age="$(( age / 3600 )) hours ago"
    else age="on $(strftime %Y-%m-%d $mtime)"; fi
    print -r -- "${label:+\"$label\", }$age"
}

_pi_session_menu() {
    # Asks whether to start a new session (and its name) or pick up a previous
    # one, and adds the matching flags to `pi_args`. Skipped when the user's
    # own arguments already choose a session or run pi non-interactively.
    local arg name attempt
    for arg in "${pi_args[@]}"; do
        [[ "$arg" == (-c|--continue|-r|--resume|--session|--session-id|--fork|--no-session|-n|--name|-p|--print) ]] && return 0
    done

    local -a sessions=("$HOME/.pi/agent/sessions/$(_pi_project_key)"/*.jsonl(N.om))  # newest first
    if (( ${#sessions} )); then
        for (( attempt = 1; ; attempt++ )); do
            _pi_menu "Session for this folder:" "New session" \
                "Continue last session ($(_pi_session_label "${sessions[1]}"))" \
                "Choose a previous session..."
            case $REPLY in
                1) break ;;
                2) pi_args+=("--continue"); return 0 ;;
                3) pi_args+=("--resume"); return 0 ;;  # pi's own picker
            esac
            if (( attempt >= _PI_MAX_RETRIES )); then
                echo "Too many failed attempts. Aborting."
                return 1
            fi
            echo "Invalid choice. Please try again."
        done
    fi

    read -r "name?Session name (optional, press Enter to skip): "
    [[ -n "$name" ]] && pi_args+=("--name" "$name")  # names pi's session and the log file
    return 0
}

_pi_log_path() {
    # Prints a log path in $sessions_dir for base name $1 that doesn't exist
    # yet, adding -2, -3, ... so a reused session name never overwrites a log.
    local log="$sessions_dir/$1.log" n=2
    while [[ -e "$log" ]]; do log="$sessions_dir/$1-$(( n++ )).log"; done
    print -r -- "$log"
}

_pi_run_new_session() {
    local tmp="$sessions_dir/.session_inprogress_$$.tmp" name log

    echo "Starting Pi session..."
    echo "DEBUG: Running command ->" "pi" "${pi_args[@]}"
    {
        script -q "$tmp" command pi "${pi_args[@]}"
        name=$(_pi_sanitize_filename "$custom_session_name")
        log=$(_pi_log_path "${name:-$(date +%Y-%m-%d_%H-%M-%S)}")
        mv "$tmp" "$log" && echo "Pi session ended. Log saved to $log"
    } always {
        # Interrupted before the log was named (e.g. Ctrl+C): keep the partial log.
        if [[ -f "$tmp" ]]; then
            log=$(_pi_log_path "$(date +%Y-%m-%d_%H-%M-%S)_INCOMPLETE")
            mv "$tmp" "$log"
            print "\nPi session terminated unexpectedly. Partial log saved to $log"
        fi
    }
}

pi() {
    # Main entry point: pick session and provider/model, then run and record pi.
    local provider_file sessions_dir custom_session_name
    local rules_file="$HOME/.pi/session_rules.md"
    local -a pi_args=("$@") provider_args rules_args

    # Subcommands (pi update, pi auth, ...) and options that just print and
    # exit (--help, --version, ...) go straight to pi: no menus, no recording.
    if [[ "$1" == (install|remove|uninstall|update|list|config|auth) ]] ||
       (( ${pi_args[(I)(--help|-h|--version|-v|--list-models|--export)]} )); then
        command pi "$@"
        return
    fi

    _pi_project_files || return 1
    ( umask 077; mkdir -p "$sessions_dir" ) || return 1  # private: holds keys and terminal logs
    _pi_session_menu || return 1
    _pi_handle_providers || return 1  # e.g. bad password
    _pi_parse_args  # log file name from --name/-n; runs before provider/rules args are added

    # pi treats --append-system-prompt as a file path if it exists, otherwise as
    # literal text - so a missing rules file would append the path itself to the
    # system prompt. Only pass it when the file is really there.
    if [[ ! -f "$rules_file" ]]; then
        echo "Warning: $rules_file not found. Starting without session rules."
    elif [[ ! -r "$rules_file" || ! -s "$rules_file" ]]; then
        echo "Warning: $rules_file is empty or unreadable. Starting without session rules."
    else
        rules_args=("--append-system-prompt" "$rules_file")
        echo "Session rules: ${rules_file/#$HOME/~} (${#${(f)"$(<"$rules_file")"}} lines)"
    fi

    pi_args=("${rules_args[@]}" "${provider_args[@]}" "${pi_args[@]}")
    _pi_run_new_session
}

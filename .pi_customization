# --- Pi Customization Helper Functions ---

# --- Section 1: Provider & Encryption Management ---

_pi_get_password() {
    # Securely prompts for and returns a password.
    # $1: The prompt string to display to the user.
    # $2 (optional): If set to "confirm", will prompt for confirmation.
    local prompt_text="$1"
    local confirmation_required="$2"
    local password=""
    local password_confirm=""

    while true; do
        read -s "password?$prompt_text"
        echo
        if [[ "$confirmation_required" == "confirm" ]]; then
            read -s "password_confirm?Confirm password: "
            echo
            if [[ "$password" == "$password_confirm" ]]; then
                break
            else
                echo "Passwords do not match. Please try again."
            fi
        else
            break
        fi
    done
    REPLY=$password
}

_pi_encrypt_providers() {
    # Encrypts provider data and saves it to the file.
    # $1: The plaintext provider data.
    # $2: The password.
    local providers_plaintext="$1"
    local password="$2"
    local provider_file=".pi_providers.enc"
    
    echo "$providers_plaintext" | openssl enc -aes-256-cbc -pass pass:"$password" -pbkdf2 -out "$provider_file"
    # Ensure file permissions are restrictive
    chmod 600 "$provider_file"
}

_pi_decrypt_providers() {
    # Decrypts the provider file and returns the plaintext.
    # $1: The password.
    # Returns 0 on success, 1 on failure.
    local password="$1"
    local provider_file=".pi_providers.enc"
    
    # openssl will return a non-zero exit code for bad passwords/decryption failure.
    openssl enc -d -aes-256-cbc -pass pass:"$password" -pbkdf2 -in "$provider_file" 2>/dev/null
}

_pi_add_new_provider() {
    # Interactively adds a new provider and key.
    # $1 (optional): The existing provider plaintext.
    # Returns the updated provider plaintext.
    local providers_plaintext="$1"
    local new_provider=""
    local new_key=""

    echo -n "Enter provider name (e.g., openai, google): "
    read new_provider
    echo -n "Enter API key for '$new_provider': "
    read -s new_key
    echo

    if [[ -z "$new_provider" || -z "$new_key" ]]; then
        echo "Provider name and key cannot be empty."
        REPLY=$providers_plaintext
        return 1
    fi
    
    local new_entry="${new_provider}=${new_key}"
    if [[ -n "$providers_plaintext" ]]; then
        REPLY="${providers_plaintext}\n${new_entry}"
    else
        REPLY="$new_entry"
    fi
}

_pi_provider_menu() {
    # Displays the interactive menu to select a provider.
    # $1: The decrypted provider plaintext.
    # Sets `selected_provider` and `selected_key` in the parent scope.
    local providers_plaintext="$1"
    local -a providers
    local -A provider_keys

    # Read the plaintext into an array and an associative array for easy lookup
    while IFS='=' read -r key value; do
        if [[ -n "$key" ]]; then
            providers+=("$key")
            provider_keys[$key]="$value"
        fi
    done <<< "$providers_plaintext"

    echo "Select a provider for this session:"
    local i=1
    for p in "${providers[@]}"; do
        echo "$i) $p"
        ((i++))
    done
    echo "---------------------"
    echo "$i) [Add a new provider]"
    ((i++))
    echo "$i) [Continue without a provider]"

    echo -n "Enter your choice: "
    read choice

    if [[ "$choice" -gt 0 && "$choice" -le "${#providers[@]}" ]]; then
        # A provider was selected
        selected_provider="${providers[$((choice-1))]}"
        selected_key="${provider_keys[$selected_provider]}"
    elif [[ "$choice" -eq $((${#providers[@]} + 1)) ]]; then
        # Add new provider
        REPLY="add_new"
    else
        # Continue without, or invalid choice
        REPLY="continue_without"
    fi
}

_pi_handle_providers() {
    # Main orchestrator for the provider management feature.
    # Sets `provider_args` in the parent scope if a provider is chosen.
    local provider_file=".pi_providers.enc"
    local password=""
    
    if [ ! -f "$provider_file" ]; then
        # Workflow A: First-time initialization
        echo -n "No provider file found. Create one? [Y/n] "
        read create_choice
        if [[ "$create_choice" != "n" && "$create_choice" != "N" ]]; then
            _pi_get_password "Enter new password for this project: " "confirm"
            password=$REPLY
            _pi_add_new_provider ""
            local new_providers=$REPLY
            _pi_encrypt_providers "$new_providers" "$password"
            
            # Set the provider for the current session
            selected_provider="${new_providers%%=*}"
            selected_key="${new_providers#*=}"
        fi
    else
        # Workflow B: Standard execution
        _pi_get_password "Enter provider password for this project: "
        password=$REPLY
        
        local providers_plaintext=$(_pi_decrypt_providers "$password")
        if [[ -z "$providers_plaintext" ]]; then
            echo "Decryption failed. Invalid password."
            return 1 # Abort
        fi

        _pi_provider_menu "$providers_plaintext"
        local menu_result=$REPLY
        
        if [[ "$menu_result" == "add_new" ]]; then
            _pi_add_new_provider "$providers_plaintext"
            local updated_providers=$REPLY
            _pi_encrypt_providers "$updated_providers" "$password"
            echo "Provider added successfully."
            # For now, we just exit. The user can re-run to select the new provider.
            return 1 # Simple approach: end here.
        fi
    fi
    
    # If a provider was selected (either on init or from menu), set the args.
    if [[ -n "$selected_provider" && -n "$selected_key" ]]; then
        provider_args=("--provider" "$selected_provider" "--api-key" "$selected_key")
        echo "Using provider: $selected_provider"
    fi
    
    return 0
}


# --- Section 2: Session Recording & Management ---

_pi_sanitize_filename() {
    echo "$1" | sed -e 's/[^a-zA-Z0-9._]/-/g' -e 's/--\+/-/g' -e 's/^-//' -e 's/-$//'
}

_pi_parse_args() {
    local temp_args=()
    for ((i = 0; i < ${#pi_args[@]}; i++)); do
        if [[ "${pi_args[i]}" == "--name" ]]; then
            if [[ -n "${pi_args[i+1]}" ]]; then
                custom_session_name="${pi_args[i+1]}"
                ((i++))
            else
                echo "Warning: --name flag provided without a value. Ignoring."
            fi
        else
            temp_args+=("${pi_args[i]}")
        fi
    done
    pi_args=("${temp_args[@]}")
}

_pi_handle_resume() {
    if [[ "${#pi_args[@]}" -gt 1 ]]; then
        echo "Error: --resume cannot be used with other arguments."
        return 1
    fi

    local session_files=($(ls -1t "$SESSIONS_DIR"/*.log 2>/dev/null | xargs -n 1 basename))
    if [ ${#session_files[@]} -eq 0 ]; then
        echo "No Pi sessions found to resume."
        return 1
    fi

    echo "Available Pi Sessions to resume (most recent first):"
    echo "---------------------------------------------------------"
    ls -1t "$SESSIONS_DIR"/*.log 2>/dev/null | xargs -n 1 basename | cat -n
    echo "---------------------------------------------------------"

    echo -n "Enter the number of the session to resume (or press Enter for the latest): "
    read session_num
    session_num=${session_num:-1}

    if ! [[ "$session_num" =~ ^[0-9]+$ ]] || [ "$session_num" -eq 0 ] || [ "$session_num" -gt "${#session_files[@]}" ]; then
        echo "Invalid session number. Aborting."
        return 1
    fi

    target_log_file="${SESSIONS_DIR}/${session_files[$((session_num - 1))]}"
    echo "Resuming session from $(basename "$target_log_file")..."
    pi_args=("--" "$(cat "$target_log_file")")
    return 0
}

_pi_run_resumed_session() {
    echo "New activity will be appended to $(basename "$target_log_file")."
    script -q -a "$target_log_file" command pi "${pi_args[@]}"
    echo "Pi session ended. Log updated in $(basename "$target_log_file")"
}

_pi_run_new_session() {
    local temp_log_file="$SESSIONS_DIR/.session_inprogress_$$.tmp"

    trap '
        if [ -f "'"$temp_log_file"'" ]; then
            local final_name="$SESSIONS_DIR/$(date +"%Y-%m-%d_%H-%M-%S")_INCOMPLETE.log"
            mv "'"$temp_log_file"'" "$final_name"
            echo -e "\nPi session terminated unexpectedly. Partial log saved to $final_name"
        fi
    ' EXIT

    echo "Starting new Pi session..."
    script -q "$temp_log_file" command pi "${pi_args[@]}"

    trap - EXIT

    local final_name=""
    if [[ -n "$custom_session_name" ]]; then
        final_name="$custom_session_name"
    else
        echo -n "Enter a name for this session (optional, press Enter for timestamp): "
        read session_name_input
        if [[ -n "$session_name_input" ]]; then
            final_name="$session_name_input"
        else
            final_name="$(date +"%Y-%m-%d_%H-%M-%S")"
        fi
    fi

    local sanitized_name=$(_pi_sanitize_filename "$final_name")
    local final_log_file="$SESSIONS_DIR/${sanitized_name}.log"

    mv "$temp_log_file" "$final_log_file"
    echo "Pi session ended. Log saved to $final_log_file"
}

pi() {
    # --- Main Entry Point & Orchestrator ---
    local SESSIONS_DIR="./.pi_sessions"
    mkdir -p "$SESSIONS_DIR"

    # Shared state variables
    local pi_args=("$@")
    local custom_session_name=""
    local target_log_file=""
    local provider_args=()
    local selected_provider="" # Used by provider helpers
    local selected_key=""      # Used by provider helpers

    # --- 1. Handle Provider Selection ---
    # This must run first to configure credentials for the session.
    # It modifies `provider_args` which is then prepended to `pi_args`.
    if ! _pi_handle_providers; then
        return 1 # Abort if provider handling fails (e.g., bad password).
    fi
    
    # Prepend any provider args to the main arguments list.
    pi_args=("${provider_args[@]}" "${pi_args[@]}")

    # --- 2. Route to Session Management Flow ---
    if [[ "$1" == "--resume" ]]; then
        if _pi_handle_resume; then
            pi_args=("--append-system-prompt" "$HOME/.pi/session_rules.md" "${pi_args[@]}")
            _pi_run_resumed_session
        fi
    else
        _pi_parse_args
        pi_args=("--append-system-prompt" "$HOME/.pi/session_rules.md" "${pi_args[@]}")
        _pi_run_new_session
    fi
}

# --- Pi Customization Helper Functions ---

# --- Section 1: Provider & Encryption Management ---

echo "Loading Pi customization functions..."

_pi_get_password() {
    # Securely prompts for and returns a password.
    # $1: The prompt string to display to the user.
    # $2 (optional): If set to "confirm", will prompt for confirmation.
    local prompt_text="$1"
    local confirmation_required="$2"
    local password=""
    local password_confirm=""

    while true; do
        read "password?$prompt_text"
        echo
        if [[ "$confirmation_required" == "confirm" ]]; then
            read "password_confirm?Confirm password: "
            echo
            if [[ "$password" == "$password_confirm" ]]; then
                break
            else
                echo "Passwords do not match. Please try again."
            fi
        else
            break
        fi
    done
    REPLY=$password
}

_pi_encrypt_providers() {
    # Encrypts provider data and saves it to the file.
    # $1: The plaintext provider data.
    # $2: The password.
    local providers_plaintext="$1"
    local password="$2"
    local provider_file=".pi_providers.enc"
    
    echo "$providers_plaintext" | openssl enc -aes-256-cbc -pass pass:"$password" -pbkdf2 -out "$provider_file"
    # Ensure file permissions are restrictive
    chmod 600 "$provider_file"
}

_pi_decrypt_providers() {
    # Decrypts the provider file and returns the plaintext.
    # $1: The password.
    # Returns 0 on success, 1 on failure.
    local password="$1"
    local provider_file=".pi_providers.enc"
    
    # openssl will return a non-zero exit code for bad passwords/decryption failure.
    openssl enc -d -aes-256-cbc -pass pass:"$password" -pbkdf2 -in "$provider_file" 2>/dev/null
}

_pi_add_new_provider() {
    # Interactively adds a new provider and key.
    # $1 (optional): The existing provider plaintext.
    # Returns the updated provider plaintext.
    local providers_plaintext="$1"
    local new_provider=""
    local new_key=""

    echo -n "Enter provider name (e.g., openai, google): "
    read new_provider
    echo -n "Enter API key for '$new_provider': "
    read new_key
    echo

    if [[ -z "$new_provider" || -z "$new_key" ]]; then
        echo "Provider name and key cannot be empty."
        REPLY=$providers_plaintext
        return 1
    fi
    
    local new_entry="${new_provider}=${new_key}"
    if [[ -n "$providers_plaintext" ]]; then
        REPLY="${providers_plaintext}\n${new_entry}"
    else
        REPLY="$new_entry"
    fi
}

_pi_provider_menu() {
    # Displays the interactive menu to select a provider.
    # $1: The decrypted provider plaintext.
    # Sets `selected_provider` and `selected_key` in the parent scope.
    local providers_plaintext="$1"
    local -a providers
    local -A provider_keys

    # Read the plaintext into an array and an associative array for easy lookup
    while IFS='=' read -r key value; do
        if [[ -n "$key" ]]; then
            providers+=("$key")
            provider_keys[$key]="$value"
        fi
    done <<< "$providers_plaintext"

    echo "Select a provider for this session:"
    local i=1
    for p in "${providers[@]}"; do
        echo "$i) $p"
        ((i++))
    done
    echo "---------------------"
    echo "$i) [Add a new provider]"
    ((i++))
    echo "$i) [Continue without a provider]"

    echo -n "Enter your choice: "
    read choice

    if ! [[ "$choice" =~ ^[0-9]+$ ]]; then
        # Non-numeric input - don't let it reach zsh arithmetic evaluation.
        REPLY="continue_without"
        return 0
    fi

    if [[ "$choice" -gt 0 && "$choice" -le "${#providers[@]}" ]]; then
        # A provider was selected. zsh arrays are 1-indexed, so the menu
        # number is already the array index - do not subtract 1.
        selected_provider="${providers[$choice]}"
        selected_key="${provider_keys[$selected_provider]}"
    elif [[ "$choice" -eq $((${#providers[@]} + 1)) ]]; then
        # Add new provider
        REPLY="add_new"
    else
        # Continue without, or invalid choice
        REPLY="continue_without"
    fi
}

_pi_model_menu() {
    # Displays an interactive menu to select a model for a given provider.
    # $1: The selected provider name (e.g., "openai").
    # Sets `selected_model` in the parent scope.
    local provider="$1"
    local model_config_file=""$(cd "$(dirname "${(%):-%x}")" && pwd)/.pi_models.conf""
    local -a model_ids
    local -a model_names
    local in_section=false

    # Use awk to parse the INI-style config file
    local models_data=$(awk -v provider="[$provider]" '
        $0 == provider { in_section = 1; next }
        /^\[/ { in_section = 0 }
        in_section && /=/ { print }
    ' "$model_config_file")

    if [[ -z "$models_data" ]]; then
        echo "Warning: No models found for provider '$provider' in $model_config_file."
        selected_model="" # Ensure it's empty
        return 1
    fi
    
    while IFS='=' read -r id name; do
        model_ids+=("$id")
        # Remove quotes from the friendly name
        model_names+=("$(echo "$name" | tr -d '\"')")
    done <<< "$models_data"

    echo "Select a model for '$provider':"
    local i=1
    for name in "${model_names[@]}"; do
        echo "$i) $name"
        ((i++))
    done

    echo -n "Enter your choice: "
    read choice

    if [[ "$choice" =~ ^[0-9]+$ ]] && [[ "$choice" -gt 0 && "$choice" -le "${#model_ids[@]}" ]]; then
        # zsh arrays are 1-indexed, so the menu number is already the array
        # index - subtracting 1 here selected the previous model in the list
        # (and nothing at all for choice 1).
        selected_model="${model_ids[$choice]}"
    else
        echo "Invalid choice. Aborting."
        selected_model=""
        return 1
    fi
    return 0
}

_pi_handle_providers() {
    # Main orchestrator for the provider management feature.
    # Sets `provider_args` in the parent scope if a provider is chosen.
    local provider_file=".pi_providers.enc"
    local model_config_file=""$(cd "$(dirname "${(%):-%x}")" && pwd)/.pi_models.conf""
    local password=""
    
    # --- New: Check for model config and create if missing ---
    if [ ! -f "$model_config_file" ]; then
        echo "Model configuration file not found. Creating a default '$model_config_file'."
        # This uses a here-document to write the default config
        cat > "$model_config_file" <<'EOF'
# This file configures the models available for each provider in the pi wrapper script.
# Format: model_id="Friendly Display Name"

[google]
gemini-flash-latest="Gemini Flash (Latest)"
gemini-1.5-pro-latest="Gemini 1.5 Pro"

[openai]
gpt-4o="GPT-4o (Omni)"
gpt-4o-mini="GPT-4o Mini"
gpt-4-turbo="GPT-4 Turbo"

[anthropic]
claude-3-5-sonnet-20240620="Claude 3.5 Sonnet"
claude-3-opus-20240229="Claude 3 Opus"
claude-3-haiku-20240307="Claude 3 Haiku"
EOF
    fi

    if [ ! -f "$provider_file" ]; then
        # Workflow A: First-time initialization
        echo -n "No provider file found. Create one? [Y/n] "
        read create_choice
        if [[ "$create_choice" != "n" && "$create_choice" != "N" ]]; then
            _pi_get_password "Enter new password for this project: " "confirm"
            password=$REPLY
            _pi_add_new_provider ""
            local new_providers=$REPLY
            _pi_encrypt_providers "$new_providers" "$password"
            
            # Set the provider for the current session
            selected_provider="${new_providers%%=*}"
            selected_key="${new_providers#*=}"
        fi
    else
        # Workflow B: Standard execution
        _pi_get_password "Enter provider password for this project: "
        password=$REPLY
        
        local providers_plaintext=$(_pi_decrypt_providers "$password")
        if [[ -z "$providers_plaintext" ]]; then
            echo "Decryption failed. Invalid password."
            return 1 # Abort
        fi

        _pi_provider_menu "$providers_plaintext"
        local menu_result=$REPLY
        
        if [[ "$menu_result" == "add_new" ]]; then
            _pi_add_new_provider "$providers_plaintext"
            local updated_providers=$REPLY
            _pi_encrypt_providers "$updated_providers" "$password"
            echo "Provider added successfully."
            # For now, we just exit. The user can re-run to select the new provider.
            return 1 # Simple approach: end here.
        fi
    fi
    
    # --- Updated Logic: Use dynamic model selection ---
    if [[ -n "$selected_provider" && -n "$selected_key" ]]; then
        local selected_model=""
        if _pi_model_menu "$selected_provider"; then
            # If a model was successfully selected
            if [[ -n "$selected_model" ]]; then
                provider_args=("--provider" "$selected_provider" "--model" "$selected_model")
                # The 'pi' command expects the API key as an environment variable (e.g., OPENAI_API_KEY),
                # not as a command-line flag. This converts the provider name to the correct env var format and exports it.
                local env_var_name
                env_var_name=$(echo "$selected_provider" | tr '[:lower:]' '[:upper:]')_API_KEY
                export "${env_var_name}=${selected_key}"

                echo "Using provider: $selected_provider, Model: $selected_model"
            else
                # This case should ideally not be hit if _pi_model_menu works correctly
                echo "Error: Model selection failed. Aborting."
                return 1
            fi
        else
            # _pi_model_menu returned a failure (e.g., no models in config or invalid choice)
            echo "Aborting due to model selection issue."
            return 1
        fi
    fi
    
    return 0
}


# --- Section 2: Session Recording & Management ---

_pi_sanitize_filename() {
    echo "$1" | sed -e 's/[^a-zA-Z0-9._]/-/g' -e 's/--\+/-/g' -e 's/^-//' -e 's/-$//'
}

_pi_parse_args() {
    # zsh arrays are 1-indexed. Iterating 0..n-1 read the empty slot 0 and
    # never reached the final element, which prepended an empty argument and
    # silently dropped the last one (e.g. the value of --model).
    local temp_args=()
    local i=1
    local argc=${#pi_args[@]}

    while (( i <= argc )); do
        if [[ "${pi_args[i]}" == "--name" ]]; then
            if (( i < argc )) && [[ -n "${pi_args[i+1]}" ]]; then
                custom_session_name="${pi_args[i+1]}"
                (( i += 2 ))
            else
                echo "Warning: --name flag provided without a value. Ignoring."
                (( i++ ))
            fi
        else
            temp_args+=("${pi_args[i]}")
            (( i++ ))
        fi
    done

    pi_args=("${temp_args[@]}")
}

# Session resumption is delegated to pi itself (--resume/-r, --continue/-c,
# --session, --fork). pi owns real conversation state; the files this wrapper
# writes to $SESSIONS_DIR are script(1) typescripts - terminal recordings with
# escape sequences and TUI chrome - and are for human reading only. The wrapper
# used to rebuild a prompt by cat-ing one back into pi, which discarded the
# selected provider, broke on logs larger than ARG_MAX (~1MB), and replayed a
# screen recording as if it were a conversation.

_pi_run_new_session() {
    local temp_log_file="$SESSIONS_DIR/.session_inprogress_$$.tmp"

    trap '
        if [ -f "'"$temp_log_file"'" ]; then
            local final_name="$SESSIONS_DIR/$(date +"%Y-%m-%d_%H-%M-%S")_INCOMPLETE.log"
            mv "'"$temp_log_file"'" "$final_name"
            echo -e "\nPi session terminated unexpectedly. Partial log saved to $final_name"
        fi
    ' EXIT

    echo "Starting Pi session..."
    echo "DEBUG: Running command ->" "pi" "${pi_args[@]}"
    script -q "$temp_log_file" command pi "${pi_args[@]}"

    trap - EXIT

    local final_name=""
    if [[ -n "$custom_session_name" ]]; then
        final_name="$custom_session_name"
    else
        echo -n "Enter a name for this session (optional, press Enter for timestamp): "
        read session_name_input
        if [[ -n "$session_name_input" ]]; then
            final_name="$session_name_input"
        else
            final_name="$(date +"%Y-%m-%d_%H-%M-%S")"
        fi
    fi

    local sanitized_name=$(_pi_sanitize_filename "$final_name")
    local final_log_file="$SESSIONS_DIR/${sanitized_name}.log"

    mv "$temp_log_file" "$final_log_file"
    echo "Pi session ended. Log saved to $final_log_file"
}

pi() {
    # --- Main Entry Point & Orchestrator ---
    local SESSIONS_DIR="./.pi_sessions"
    mkdir -p "$SESSIONS_DIR"

    # Shared state variables
    local pi_args=("$@")
    local custom_session_name=""
    local provider_args=()
    local selected_provider="" # Used by provider helpers
    local selected_key=""      # Used by provider helpers

    # --- 1. Handle Provider Selection ---
    # This must run first to configure credentials for the session.
    # It sets `provider_args`, which is folded into the command line below.
    if ! _pi_handle_providers; then
        return 1 # Abort if provider handling fails (e.g., bad password).
    fi

    # --- 2. Strip wrapper-only flags (--name) from the user's arguments ---
    # Runs against the user's own args only, before provider args are added,
    # so the wrapper never inspects arguments it injected itself.
    _pi_parse_args

    # --- 3. Assemble the command line and run ---
    # Session flags (--resume/-r, --continue/-c, --session, --fork) are passed
    # through untouched: pi owns session state, this wrapper only records the
    # terminal. See the note above _pi_run_new_session.
    pi_args=("--append-system-prompt" "$HOME/.pi/session_rules.md" \
             "${provider_args[@]}" "${pi_args[@]}")

    _pi_run_new_session
}
